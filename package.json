{
  "name": "menuyukti",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:all": "./scripts/start-all-services.sh",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format-check": "prettier --check \"**/*.{ts,tsx,md,css}\"",
    "format-fix": "prettier --write \"**/*.{ts,tsx,md,css}\"",
    "check-types": "turbo check-types",
    "docker:build:graphql": "docker build -f apps/graphql/Dockerfile -t johngoyason/menuyukti-graphql:${DOCKER_TAG:-latest} .",
    "docker:build:web": "docker build -f apps/web/Dockerfile -t johngoyason/menuyukti-web:${DOCKER_TAG:-latest} --build-arg DATABASE_URL=\\\"$DATABASE_URL\\\" --build-arg ANALYTICS_API_URL=\\\"${ANALYTICS_API_URL:-http://graphql:8000}\\\" .",
    "docker:build:agents": "docker build -f apps/gentic-agents/Dockerfile -t johngoyason/menuyukti-agents:${DOCKER_TAG:-latest} .",
    "docker:build:all": "pnpm run docker:build:graphql && pnpm run docker:build:agents && pnpm run docker:build:web",
    "docker:push:graphql": "bash scripts/docker-push-images.sh graphql",
    "docker:push:web": "bash scripts/docker-push-images.sh web",
    "docker:push:agents": "bash scripts/docker-push-images.sh agents",
    "docker:push:all": "bash scripts/docker-push-images.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9.32.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.5",
    "typescript": "5.7.3"
  },
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=20"
  }
}
