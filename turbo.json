{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "AI_GATEWAY_API_KEY",
    "AGENTS_API_URL",
    "AGENTS_URL",
    "PYTHON_AGENTS_URL",
    "AWS_REGION",
    "AWS_S3_BUCKET",
    "CLERK_PUBLISHABLE_KEY",
    "CLERK_SECRET_KEY",
    "CLERK_WEBHOOK_SIGNING_SECRET",
    "GRAPHQL_ENDPOINT",
    "GRAPHQL_INTERNAL_API_KEY",
    "LEONARDO_API_KEY",
    "NODE_ENV",
    "PORT",
    "NEXT_PUBLIC_APP_CURRENCY",
    "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY",
    "VERCEL_OIDC_TOKEN",
    "WAREHOUSE_READS_ENABLED"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ],
      "env": [
        "NODE_ENV"
      ]
    },
    "format-check": {
      "dependsOn": [
        "^format-check"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {}
  }
}
