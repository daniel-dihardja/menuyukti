# =============================================================================
# Menuyukti — environment variables (reference)
# =============================================================================
#
# Copy values into the `.env` file(s) you use:
# - Repo root `.env` — used by `docker compose` (see `docker-compose.yml`).
# - Per-app `.env` — e.g. `apps/web/.env`, `apps/graphql/.env`, `apps/agents/.env`
#   when running services locally without Docker (see each app’s README).
#
# Never commit real secrets. Replace placeholder values before running in production.
#

# -----------------------------------------------------------------------------
# GraphQL API (`apps/graphql`) — Strawberry + SQLAlchemy, default port 8000
# -----------------------------------------------------------------------------

# Required for Postgres (e.g. Neon). Defaults to local SQLite if unset.
# Example: postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=

# When set, every HTTP request must send header `X-Internal-Api-Key` with this value.
# In Docker Compose this is usually the same secret as `GRAPHQL_INTERNAL_API_KEY` below.
INTERNAL_API_KEY=

# -----------------------------------------------------------------------------
# Web (`apps/web`) — Next.js, default port 3000
# -----------------------------------------------------------------------------

# Clerk — required for auth (see `lib/clerk-env.ts`, `middleware.ts`)
CLERK_SECRET_KEY=
# Publishable key (pk_…). Inlined at build time; also supported at runtime as `CLERK_PUBLISHABLE_KEY`.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Optional: same value as `NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY` for Docker/runtime when the image was built without the public env.
CLERK_PUBLISHABLE_KEY=
# Optional — only if you use Clerk middleware dynamic keys (see Clerk Next.js docs).
# CLERK_ENCRYPTION_KEY=

# GraphQL HTTP API — used by server components and `app/api/*` BFF routes (`lib/graphql/client.ts`)
GRAPHQL_ENDPOINT=http://127.0.0.1:8000/graphql
# Optional: sent as `X-Internal-Api-Key` when calling GraphQL (must match `INTERNAL_API_KEY` on the GraphQL service).
GRAPHQL_INTERNAL_API_KEY=

# LangGraph agents service (`apps/agents`) — base URL, no trailing slash (`lib/config.ts`)
# `AGENTS_URL` is preferred (e.g. Docker). `PYTHON_AGENTS_URL` is a local dev alias.
# `AGENTS_API_URL` is listed in root `turbo.json` globalEnv (cache inputs) but the app reads `AGENTS_URL` / `PYTHON_AGENTS_URL`.
# When `GRAPHQL_INTERNAL_API_KEY` is set, web sends it as `X-Internal-Api-Key` to agents (must match agents inbound key).
AGENTS_URL=http://127.0.0.1:8001
# PYTHON_AGENTS_URL=http://127.0.0.1:8001
# AGENTS_API_URL=http://127.0.0.1:8001

# Optional — referenced by `docker-compose.yml` for future server-to-server auth to agents.
# AGENTS_API_KEY=

# AWS S3 — presigned URLs for private assets (`lib/assets/storage.ts`).
# Credentials use the default AWS SDK chain (e.g. `AWS_ACCESS_KEY_ID`, `AWS_SECRET_ACCESS_KEY`, or IAM role) when not running with ambient credentials.
AWS_REGION=
AWS_S3_BUCKET=menuyukti

# Optional — Leonardo AI image generations (`lib/leonardo.ts`).
# LEONARDO_API_KEY=

# Optional — default app currency for UI (ISO code, e.g. IDR, USD).
# NEXT_PUBLIC_APP_CURRENCY=USD

# Optional — set to `1` to enable warehouse-backed read paths (`lib/warehouse-read-path.ts`).
# WAREHOUSE_READS_ENABLED=0

# Optional — baked into `next build` / Docker builder for production images (`apps/web/Dockerfile`).
# Not required for typical local `pnpm dev` unless your tooling expects them.
# DATABASE_URL=
# ANALYTICS_API_URL=http://127.0.0.1:8000

# Standard Node / Next (usually set by the runtime; listed for completeness).
# NODE_ENV=development

# -----------------------------------------------------------------------------
# LangGraph agents (`apps/agents`) — FastAPI, default port 8001
# -----------------------------------------------------------------------------

AI_GATEWAY_API_KEY=
# On Vercel, VERCEL_OIDC_TOKEN may be used instead of the key above.
# Optional — overrides default model (`apps/agents/models/llm_config.py`); bare names get openai/ prefix.
# OPENAI_MODEL=gpt-4o-mini

# GraphQL URL for server-to-server calls from agents (`agents/graphql_base.py`).
GRAPHQL_ENDPOINT=http://127.0.0.1:8000/graphql
GRAPHQL_INTERNAL_API_KEY=

# Optional — web app URL for IG Studio chat image generation (agents → POST /api/posts/generate).
# WEB_APP_URL=http://127.0.0.1:3000

# Optional — see Docker Compose / `apps/agents/Dockerfile` (intended for protecting agent HTTP routes).
# AGENTS_API_KEY=

# -----------------------------------------------------------------------------
# Developer tooling (optional)
# -----------------------------------------------------------------------------

# `apps/graphql/scripts/load_dev_data.py` — override the default dev Clerk user id when seeding.
# DEV_CLERK_USER_ID=

# -----------------------------------------------------------------------------
# End-to-end tests — copy `apps/web/.env.e2e.example` to `apps/web/.env.e2e` and adjust.
# -----------------------------------------------------------------------------
#
# DATABASE_URL=
# ANALYTICS_API_URL=http://127.0.0.1:8000
# AGENTS_API_URL=http://127.0.0.1:8001
# E2E_BASE_URL=http://127.0.0.1:3000
# E2E_DB_FORBIDDEN_PATTERN=(prod|production)
# E2E_DB_REQUIRED_PATTERN=
# E2E_SUITE_LIST=
