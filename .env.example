# =============================================================================
# Menuyukti — environment variables (canonical reference)
# =============================================================================
#
# Canonical file for local + Docker Compose: **repo-root `.env`**
# (copy this file → `.env` at the monorepo root).
#
# Load order (Python GraphQL / agents):
#   1. Process env already set (wins; not cleared)
#   2. Repo-root `.env` (`override=False`)
#   3. Optional `apps/<svc>/.env` (`override=True`) — service-only overrides
#
# Next.js (`apps/web`): `envDir` points at the monorepo root, so it reads the
# same root `.env` / `.env.local` / `.env.development` as Compose.
#
# Migration: merge shared keys from old `apps/*/.env` into root once; leave
# app files only for overrides (see each app’s `.env.example`).
#
# Never commit real secrets. Replace placeholders before production.
#

# -----------------------------------------------------------------------------
# Shared — GraphQL, web, agents, Compose
# -----------------------------------------------------------------------------

# Required for Postgres (e.g. Neon). GraphQL defaults to local SQLite if unset.
# Example: postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=

# When set, GraphQL requires header `X-Internal-Api-Key` with this value.
# Compose maps `GRAPHQL_INTERNAL_API_KEY` → GraphQL `INTERNAL_API_KEY`.
INTERNAL_API_KEY=
GRAPHQL_INTERNAL_API_KEY=

# GraphQL HTTP endpoint (web BFF + agents tools)
GRAPHQL_ENDPOINT=http://127.0.0.1:8000/graphql

# Vercel AI Gateway — agents chat + GraphQL knowledge ingest embeddings
AI_GATEWAY_API_KEY=
# On Vercel, VERCEL_OIDC_TOKEN may be used instead of the key above.
# Optional direct OpenAI key (embeddings fallback if gateway unset)
# OPENAI_API_KEY=
# KNOWLEDGE_EMBEDDING_MODEL=text-embedding-3-small
# KNOWLEDGE_EMBEDDING_BASE_URL=https://ai-gateway.vercel.sh/v1

# Durable LangGraph chat checkpoints (agents). Compose often sets this from DATABASE_URL.
# LANGGRAPH_CHECKPOINT_DATABASE_URL=

# -----------------------------------------------------------------------------
# Web (`apps/web`) — Next.js, default port 3000
# -----------------------------------------------------------------------------

# Clerk — required for auth (see `lib/clerk-env.ts`, `middleware.ts`)
CLERK_SECRET_KEY=
# Publishable key (pk_…). Inlined at build time; also supported at runtime as `CLERK_PUBLISHABLE_KEY`.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Optional: same value as `NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY` for Docker/runtime when the image was built without the public env.
CLERK_PUBLISHABLE_KEY=
# Optional — only if you use Clerk middleware dynamic keys (see Clerk Next.js docs).
# CLERK_ENCRYPTION_KEY=

# Marketing chrome: header Sign in for signed-out visitors. Set `false` to hide (prod Docker default).
# Unset or `true` keeps it visible (local `pnpm dev`). `/login` stays available either way.
# Explore (`/explore`) is auth-only via Clerk — not controlled by this flag.
NEXT_PUBLIC_SHOW_MARKETING_SIGN_IN=true

# LangGraph agents service — base URL, no trailing slash (`lib/config.ts`)
# `AGENTS_URL` is preferred (e.g. Docker). `PYTHON_AGENTS_URL` is a local dev alias.
# When `GRAPHQL_INTERNAL_API_KEY` is set, web sends it as `X-Internal-Api-Key` to agents.
AGENTS_URL=http://127.0.0.1:8001
# PYTHON_AGENTS_URL=http://127.0.0.1:8001
# AGENTS_API_URL=http://127.0.0.1:8001

# Optional — referenced by `docker-compose.yml` for future server-to-server auth to agents.
# AGENTS_API_KEY=

# AWS S3 — presigned URLs for private assets (`lib/assets/storage.ts`).
AWS_REGION=
AWS_S3_BUCKET=menuyukti

# Optional — Leonardo AI image generations (`lib/leonardo.ts`).
# LEONARDO_API_KEY=

# Optional — default app currency for UI (ISO code, e.g. IDR, USD).
# NEXT_PUBLIC_APP_CURRENCY=USD

# Google Maps JavaScript API — Nearby Locations map canvas (browser).
# Places calls stay on agents (GOOGLE_MAPS_API_KEY in apps/agents/.env override).
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# OpenAI ChatKit domain key (Platform → Settings → Security → Domain allowlist).
# NEXT_PUBLIC_CHATKIT_DOMAIN_KEY=domain_pk_…

# Optional — set to `1` to enable warehouse-backed read paths (`lib/warehouse-read-path.ts`).
# WAREHOUSE_READS_ENABLED=0

# Optional — CORS allowlist for Expo web calling public mobile BFF (`/api/mobile/*`).
# MOBILE_CORS_ORIGINS=http://localhost:8081,http://localhost:8082

# Optional — web vitals (also fine in apps/web/.env as overrides)
# NEXT_PUBLIC_ENABLE_WEB_VITALS=true
# ENABLE_WEB_VITALS_LOGS=true

# Optional — landing sample menu slug
# NEXT_PUBLIC_LANDING_SAMPLE_MENU_SLUG=

# -----------------------------------------------------------------------------
# LangGraph agents (`apps/agents`) — shared keys above; overrides in apps/agents/.env
# -----------------------------------------------------------------------------

# Optional — overrides default model (`apps/agents/models/llm_config.py`)
# OPENAI_MODEL=gpt-5.4

# Optional — web app URL for IG Studio chat image generation (agents → POST /api/posts/generate).
# WEB_APP_URL=http://127.0.0.1:3000

# -----------------------------------------------------------------------------
# Square Connect (TASK-9) — GraphQL OAuth + POS sync; web uses public app id
# -----------------------------------------------------------------------------
#
# Sandbox first. Production values go in deployed secrets, not this file.
# Marketplace product flow uses OAuth (application id/secret); do not ask sellers
# for personal access tokens.
#
# Dev-only: SQUARE_ACCESS_TOKEN can be a Sandbox personal/access token for
# early API spikes before OAuth is wired. Prefer OAuth tokens stored encrypted
# per workspace once TASK-9.2 lands.

# sandbox | production
SQUARE_ENVIRONMENT=sandbox

# Developer Console → your app → Sandbox / Production credentials
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=

# HTTPS OAuth redirect registered in the Square app (exact match).
# Local example once callback route exists:
# SQUARE_OAUTH_REDIRECT_URL=https://localhost:3000/api/integrations/square/callback
SQUARE_OAUTH_REDIRECT_URL=

# Public base URL of the web app (used to build authorize/callback links if needed).
# SQUARE_OAUTH_REDIRECT_URL is authoritative when set.
# NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# AES key for encrypting per-workspace Square access/refresh tokens at rest
# (generate a long random secret; staging and production must differ).
SQUARE_TOKEN_ENCRYPTION_KEY=

# Optional — Sandbox-only spike token (not for marketplace sellers / production).
# SQUARE_ACCESS_TOKEN=

# Optional — pin Square API version header (SDK default is fine if unset).
# SQUARE_VERSION=2025-04-16

# -----------------------------------------------------------------------------
# Developer tooling (optional)
# -----------------------------------------------------------------------------

# `apps/graphql/scripts/load_dev_data.py` — override the default dev Clerk user id when seeding.
# DEV_CLERK_USER_ID=

# -----------------------------------------------------------------------------
# End-to-end tests — copy `apps/web/.env.e2e.example` to `apps/web/.env.e2e` and adjust.
# -----------------------------------------------------------------------------
#
# DATABASE_URL=
# ANALYTICS_API_URL=http://127.0.0.1:8000
# AGENTS_API_URL=http://127.0.0.1:8001
# E2E_BASE_URL=http://127.0.0.1:3000
# E2E_DB_FORBIDDEN_PATTERN=(prod|production)
# E2E_DB_REQUIRED_PATTERN=
# E2E_SUITE_LIST=
