{
  "artifact_schema_version": "pilot-iteration-artifacts-v1",
  "run_path_template": "apps/agents/pilot/prompt-tuning/outputs/runs/<run_id>/iter-<n>/",
  "artifacts": {
    "output.json": {
      "required_fields": [
        "run_id",
        "iteration",
        "prompt_version",
        "agent_id",
        "prompt_text",
        "cases"
      ]
    },
    "score.json": {
      "required_fields": [
        "run_id",
        "iteration",
        "prompt_version",
        "scoring_matrix_version",
        "threshold",
        "total_score",
        "pass_fail",
        "dimension_scores",
        "failed_checks",
        "baseline_delta",
        "stop_reason"
      ]
    },
    "iteration-summary.json": {
      "required_fields": [
        "run_id",
        "iteration",
        "prompt_version",
        "output_path",
        "score_path",
        "total_score",
        "pass_fail",
        "baseline_delta",
        "stop_reason",
        "next_action",
        "failed_dimensions",
        "failed_checks"
      ]
    }
  }
}
