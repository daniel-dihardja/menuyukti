# Agents service-only overrides (optional).
#
# Shared secrets live in the **repo-root** `.env` (see `/.env.example`):
# AI_GATEWAY_API_KEY, GRAPHQL_ENDPOINT, GRAPHQL_INTERNAL_API_KEY / INTERNAL_API_KEY,
# DATABASE_URL / LANGGRAPH_CHECKPOINT_DATABASE_URL, WEB_APP_URL, AGENTS_API_KEY.
#
# Python loads root `.env` first, then this file with override=True.
# Do not duplicate shared keys here unless you intentionally override them.

# Optional: Postgres URL for LangGraph chat checkpoints (short-term thread memory).
# Prefer setting LANGGRAPH_CHECKPOINT_DATABASE_URL (or DATABASE_URL) in root `.env`.
# Required in production (service fails startup without it when ENV/VERCEL_ENV/NODE_ENV/AGENTS_ENV=production,
# or when AGENTS_REQUIRE_CHECKPOINT_DB=1). When unset in local dev, InMemorySaver is used (lost on restart).
# LANGGRAPH_CHECKPOINT_DATABASE_URL=postgresql://user:pass@localhost:5432/dbname
# AGENTS_REQUIRE_CHECKPOINT_DB=1

# Optional: override model. Bare name is prefixed with openai/ (e.g. gpt-4o-mini → openai/gpt-4o-mini).
# OPENAI_MODEL=gpt-5.4

# Optional: Tavily web search — enables the ``search_web`` tool in chat when set,
# and enriches Nearby Locations scans when available.
# TAVILY_API_KEY=

# Google Maps / Places (Nearby Locations playbook scan — Places API New + Geocoding via text search).
# Never expose this key to the browser; web Maps JS uses NEXT_PUBLIC_GOOGLE_MAPS_API_KEY separately.
# GOOGLE_MAPS_API_KEY=
# GOOGLE_API_KEY=  # fallback alias if GOOGLE_MAPS_API_KEY is unset

# Force production-style inbound key checks.
# AGENTS_REQUIRE_INTERNAL_API_KEY=1

# LangSmith tracing (optional — LangChain / LangGraph; see README)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=menuyukti-agents

# Optional: deep-link from DB ``external_trace_url`` (``{run_id}`` substituted)
# LANGSMITH_RUN_URL_TEMPLATE=https://smith.langchain.com/o/default/projects/p/YOUR_PROJECT/r/{run_id}
