# Optional: Postgres URL for LangGraph chat checkpoints (short-term thread memory).
# Required in production (service fails startup without it when ENV/VERCEL_ENV/NODE_ENV/AGENTS_ENV=production,
# or when AGENTS_REQUIRE_CHECKPOINT_DB=1). When unset in local dev, InMemorySaver is used (lost on restart).
# Use a plain postgresql:// URL (psycopg). Agents use AsyncPostgresSaver + AsyncConnectionPool
# (not a single long-lived connection — avoids "the connection is closed" after idle timeouts).
# LANGGRAPH_CHECKPOINT_DATABASE_URL=postgresql://user:pass@localhost:5432/dbname
# First deploy: the saver runs setup() once on startup to create checkpoint tables.
# AGENTS_REQUIRE_CHECKPOINT_DB=1

# Vercel AI Gateway (required for chat) — https://vercel.com/docs/ai-gateway#using-the-ai-gateway-with-an-api-key
AI_GATEWAY_API_KEY=
# On Vercel deployments you may use VERCEL_OIDC_TOKEN instead (injected automatically).

# Optional: override model. Bare name is prefixed with openai/ (e.g. gpt-4o-mini → openai/gpt-4o-mini).
# Use provider/model to pass a full gateway id.
# OPENAI_MODEL=gpt-5.4

# Optional: Tavily web search — enables the ``search_web`` tool in chat when set.
# TAVILY_API_KEY=

# GraphQL (required for location/chart/media tools — same endpoint/key as apps/web)
GRAPHQL_ENDPOINT=
# Shared secret with GraphQL / web BFF. Required in production (startup fails if missing).
# Either INTERNAL_API_KEY or GRAPHQL_INTERNAL_API_KEY works for:
# - inbound requests (except GET /health) requiring matching X-Internal-Api-Key
# - outbound GraphQL and web /api/posts/generate calls (X-Internal-Api-Key)
# GRAPHQL_INTERNAL_API_KEY=
# INTERNAL_API_KEY=
# AGENTS_REQUIRE_INTERNAL_API_KEY=1

# Optional — web app base URL for IG Studio / Image Assistant chat image generation
# (agents call POST {WEB_APP_URL}/api/posts/generate with X-Internal-Api-Key + X-User-Id).
# WEB_APP_URL=http://127.0.0.1:3000

# LangSmith tracing (optional — LangChain / LangGraph; see README)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=menuyukti-agents

# Optional: deep-link from DB ``external_trace_url`` (``{run_id}`` substituted)
# LANGSMITH_RUN_URL_TEMPLATE=https://smith.langchain.com/o/default/projects/p/YOUR_PROJECT/r/{run_id}
