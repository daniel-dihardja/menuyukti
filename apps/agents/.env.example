# Optional: Postgres URL for LangGraph chat checkpoints (short-term thread memory). When unset, an in-memory saver is used (lost on restart).
# Required for durable chat history across agents restarts / web refresh (GET /chat/history).
# Use a plain postgresql:// URL (psycopg). Agents use AsyncPostgresSaver for the async chat graph.
# LANGGRAPH_CHECKPOINT_DATABASE_URL=postgresql://user:pass@localhost:5432/dbname
# First deploy: the saver runs setup() once on startup to create checkpoint tables.

# Vercel AI Gateway (required for chat) — https://vercel.com/docs/ai-gateway#using-the-ai-gateway-with-an-api-key
AI_GATEWAY_API_KEY=
# On Vercel deployments you may use VERCEL_OIDC_TOKEN instead (injected automatically).

# Optional: override model. Bare name is prefixed with openai/ (e.g. gpt-4o-mini → openai/gpt-4o-mini).
# Use provider/model to pass a full gateway id.
# OPENAI_MODEL=gpt-4o-mini

# Optional: Tavily web search — enables the ``search_web`` tool in chat (ReAct) and in the milestone tool bundle when set.
# TAVILY_API_KEY=

# GraphQL (required for milestone run — same endpoint/key as apps/web)
GRAPHQL_ENDPOINT=
# Shared secret with GraphQL `INTERNAL_API_KEY` / web `GRAPHQL_INTERNAL_API_KEY`.
# When set, inbound requests (except GET /health) must send matching `X-Internal-Api-Key`.
# Also sent outbound to GraphQL as `X-Internal-Api-Key`.
# GRAPHQL_INTERNAL_API_KEY=
# INTERNAL_API_KEY=

# Optional — web app base URL for IG Studio chat image generation
# (agents call POST {WEB_APP_URL}/api/posts/generate with X-Internal-Api-Key + X-User-Id).
# WEB_APP_URL=http://127.0.0.1:3000

# LangSmith tracing (optional — LangChain / LangGraph; see README)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=menuyukti-agents

# Optional: deep-link from DB ``external_trace_url`` (``{run_id}`` substituted)
# LANGSMITH_RUN_URL_TEMPLATE=https://smith.langchain.com/o/default/projects/p/YOUR_PROJECT/r/{run_id}
