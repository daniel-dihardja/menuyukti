# Public Next.js BFF base URL (no trailing slash). Enroll uses
# {EXPO_PUBLIC_CRM_API_URL}/api/mobile/crm/v1/enroll
# Simulator / local: http://localhost:3000 (apps/web)
# Physical device on LAN (dev only): http://<your-lan-ip>:3000
# Production / staging: use HTTPS (e.g. https://app.example.com)
EXPO_PUBLIC_CRM_API_URL=http://localhost:3000
