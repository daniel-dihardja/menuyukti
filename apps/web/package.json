{
  "name": "web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:e2e:sales": "tsx e2e/analytics-sales-upload.e2e.ts",
    "postinstall": "prisma generate",
    "db:reset": "prisma migrate reset --force",
    "db:init": "prisma migrate dev --name init",
    "db:gen": "prisma generate",
    "db:seed": "prisma db seed",
    "db:seed:export": "node --import tsx scripts/export-neon-seed-sql.ts",
    "db:seed:smoke": "node --import tsx scripts/seed-smoke-check.ts",
    "test:e2e:matrix": "tsx e2e/analytics-matrix-filter-journey.e2e.ts",
    "test:e2e:pairs": "tsx e2e/analytics-pairs-gui.e2e.ts",
    "test:e2e:heatmap": "tsx e2e/analytics-heatmap-improvements.e2e.ts",
    "test:e2e:scheduler": "tsx e2e/analytics-scheduler-workflow.e2e.ts",
    "test:e2e:attribution": "tsx e2e/analytics-attribution-workflow.e2e.ts",
    "test:e2e:cogs": "tsx e2e/analytics-cogs-completeness.e2e.ts",
    "test:e2e:recovery": "tsx e2e/analytics-recovery-operations.e2e.ts",
    "test:e2e:pairs:pair-type": "tsx e2e/analytics-pairs-pair-type.e2e.ts",
    "test:e2e:release-gate": "tsx e2e/release-gate-marketer-analyst.e2e.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@prisma/adapter-neon": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@workspace/ui": "workspace:*",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "next": "^16.0.10",
    "next-intl": "^4.3.12",
    "next-themes": "^0.4.6",
    "playwright": "^1.57.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.19.9",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitest/coverage-v8": "^4.0.9",
    "@vitest/ui": "^4.0.9",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/typescript-config": "workspace:*",
    "prisma": "^7.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^4.0.9"
  }
}
