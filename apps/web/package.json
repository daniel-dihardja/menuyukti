    "test:e2e:pairs": "node --import tsx scripts/run-e2e-suite.ts e2e/analytics-pairs-gui.e2e.ts",
    "test:e2e:heatmap": "node --import tsx scripts/run-e2e-suite.ts e2e/analytics-heatmap-improvements.e2e.ts",
