{
  "name": "web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:e2e:sales": "node --import tsx scripts/run-e2e-suite.ts e2e/analytics-sales-upload.e2e.ts",
    "test:e2e:seed": "E2E_REQUIRED_SERVICES=none node --import tsx scripts/run-e2e-suite.ts e2e/seed-creation.e2e.ts",
    "test:e2e:api:contracts": "node --import tsx scripts/run-e2e-suite.ts e2e/api-contracts.e2e.ts",
    "postinstall": "prisma generate",
    "db:reset": "prisma migrate reset --force",
    "db:init": "prisma migrate dev --name init",
    "db:gen": "prisma generate",
    "db:seed": "prisma db seed",
    "db:seed:scenario": "node --env-file=.env --import tsx scripts/seed-scenarios.ts",
    "db:seed:scenario:list": "node --env-file=.env --import tsx scripts/seed-scenarios.ts --list",
    "db:seed:scenario:all": "node --env-file=.env --import tsx scripts/seed-scenarios.ts --all",
    "db:backfill:etl-lineage": "node --env-file=.env --import tsx scripts/backfill-etl-lineage.ts",
    "db:backfill:agent-output-compat": "node --env-file=.env --import tsx scripts/backfill-agent-output-compat.ts",
    "db:seed:export": "node --env-file=.env --import tsx scripts/export-neon-seed-sql.ts",
    "db:seed:smoke": "node --env-file=.env --import tsx scripts/seed-smoke-check.ts",
    "test:e2e:matrix": "node --import tsx scripts/run-e2e-suite.ts e2e/analytics-matrix-filter-journey.e2e.ts",
    "test:e2e:pairs": "node --import tsx scripts/run-e2e-suite.ts e2e/analytics-pairs-gui.e2e.ts",
    "test:e2e:heatmap": "node --import tsx scripts/run-e2e-suite.ts e2e/analytics-heatmap-improvements.e2e.ts",
    "test:e2e:scheduler": "node --import tsx scripts/run-e2e-suite.ts e2e/analytics-scheduler-workflow.e2e.ts",
    "test:e2e:scheduler:post-generation": "node --import tsx scripts/run-e2e-suite.ts e2e/analytics-scheduler-post-generation.e2e.ts",
    "test:e2e:attribution": "node --import tsx scripts/run-e2e-suite.ts e2e/analytics-attribution-workflow.e2e.ts",
    "test:e2e:cogs": "node --import tsx scripts/run-e2e-suite.ts e2e/analytics-cogs-completeness.e2e.ts",
    "test:e2e:pairs:pair-type": "node --import tsx scripts/run-e2e-suite.ts e2e/analytics-pairs-pair-type.e2e.ts",
    "test:e2e:release-gate": "node --import tsx scripts/run-e2e-suite.ts e2e/release-gate-marketer-analyst.e2e.ts",
    "test:e2e:menu-strategist": "node --import tsx scripts/run-e2e-suite.ts e2e/menu-strategist-agent.e2e.ts",
    "test:e2e:batch": "node --import tsx scripts/run-e2e-shared-services.ts",
    "test:e2e:batch:smoke": "E2E_SUITE_LIST=test:e2e:matrix,test:e2e:pairs,test:e2e:api:contracts node --import tsx scripts/run-e2e-shared-services.ts",
    "test:e2e:full": "node --import tsx scripts/run-e2e-full.ts",
    "test:e2e:full:smoke": "E2E_SUITE_LIST=test:e2e:matrix node --import tsx scripts/run-e2e-full.ts"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.99",
    "@neondatabase/serverless": "^1.0.2",
    "@prisma/adapter-neon": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@workspace/ui": "workspace:*",
    "ai": "^6.0.97",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "next": "^16.0.10",
    "next-intl": "^4.3.12",
    "next-themes": "^0.4.6",
    "openai": "^6.22.0",
    "playwright": "^1.57.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.19.9",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitest/coverage-v8": "^4.0.9",
    "@vitest/ui": "^4.0.9",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/typescript-config": "workspace:*",
    "prisma": "^7.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^4.0.9"
  }
}