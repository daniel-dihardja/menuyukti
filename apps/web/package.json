{
  "name": "web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --webpack",
    "analyze": "ANALYZE=true next build --webpack",
    "start": "next start",
    "format": "prettier --write app components hooks lib i18n messages scripts middleware.ts vitest.config.ts",
    "format:check": "prettier --check app components hooks lib i18n messages scripts middleware.ts vitest.config.ts",
    "format-check": "prettier --check app components hooks lib i18n messages scripts middleware.ts vitest.config.ts",
    "lint": "eslint app components hooks lib i18n middleware.ts vitest.config.ts --max-warnings 0",
    "lint:fix": "eslint app components hooks lib i18n middleware.ts vitest.config.ts --fix --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "check-types": "tsc --noEmit",
    "test": "vitest",
    "graphql:codegen": "graphql-codegen --config codegen.yml",
    "graphql:check": "node scripts/check-graphql-operations.mjs"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.99",
    "@aws-sdk/client-s3": "^3.1023.0",
    "@aws-sdk/s3-request-presigner": "^3.1023.0",
    "@clerk/backend": "^2.29.0",
    "@clerk/nextjs": "^7.0.7",
    "@next/third-parties": "^16.2.4",
    "@serwist/next": "^9.5.10",
    "@types/d3-format": "^3.0.4",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-scale": "^4.0.9",
    "@workspace/ui": "workspace:*",
    "ai": "^6.0.97",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "d3-format": "^3.1.2",
    "d3-hierarchy": "^3.1.2",
    "d3-scale": "^4.0.2",
    "lucide-react": "^0.475.0",
    "next": "^16.0.10",
    "next-intl": "^4.3.12",
    "nuqs": "^2.8.9",
    "openai": "^6.22.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "serwist": "^9.5.10",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^6.2.1",
    "@graphql-codegen/typescript": "^5.0.9",
    "@next/bundle-analyzer": "^16.2.3",
    "@types/d3": "^7.4.3",
    "@types/node": "^20.19.9",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitest/coverage-v8": "^4.0.9",
    "@vitest/ui": "^4.0.9",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/typescript-config": "workspace:*",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^4.0.9"
  }
}
