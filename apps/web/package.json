  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@prisma/adapter-neon": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@workspace/ui": "workspace:*",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "next": "^16.0.10",
    "next-intl": "^4.3.12",
    "next-themes": "^0.4.6",
    "playwright": "^1.57.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.19.9",
