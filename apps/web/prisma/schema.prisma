// Prisma schema for Menuyukti
// Source of truth for PostgreSQL (Neon)
// Managed via Prisma Migrate

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "staging", "warehouse", "marts"]
}

//
// --------------------------------------------------
// Location (lightweight context / namespace)
// --------------------------------------------------
//

model Location {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  currencyCode String @default("IDR") @map("currency_code")
  createdAt DateTime @default(now()) @map("created_at")

  analytics    Analytics[]
  fixedCosts FixedCost[]   // NEW
  agentOutputs AgentOutput[]
  etlJobs      EtlJob[]
  etlPipelineRuns EtlPipelineRun[]
  etlPipelineStageExecutions EtlPipelineStageExecution[]
  menuAliases  MenuAlias[]
  anomalyEvents AnomalyEvent[]
  instagramCampaigns InstagramCampaign[]
  instagramPosts InstagramPost[]
  instagramPostPromotedItems InstagramPostPromotedItem[]
  instagramWeeklySchedules InstagramWeeklySchedule[]
  instagramWeeklyScheduleEntries InstagramWeeklyScheduleEntry[]
  instagramSchedulePostDrafts InstagramSchedulePostDraft[]

  @@map("branches")
  @@schema("public")
}

model AnomalyEvent {
  id Int @id @default(autoincrement())

  locationId Int      @map("branch_id")
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  analyticsId Int?      @map("analytics_id")
  analytics   Analytics? @relation(fields: [analyticsId], references: [id], onDelete: SetNull)

  pipelineRunId String? @db.Uuid @map("pipeline_run_id")
  anomalyType   String  @map("anomaly_type")
  metricName    String  @map("metric_name")
  previousValue Decimal? @db.Decimal(18, 6) @map("previous_value")
  currentValue  Decimal? @db.Decimal(18, 6) @map("current_value")
  deltaValue    Decimal? @db.Decimal(18, 6) @map("delta_value")
  severity      String
  metadata      Json?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([locationId, createdAt], map: "ix_anomaly_event_branch_created_at")
  @@index([pipelineRunId], map: "ix_anomaly_event_pipeline_run_id")
  @@map("anomaly_events")
  @@schema("public")
}

model MenuAlias {
  id Int @id @default(autoincrement())

  locationId Int      @map("branch_id")
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  aliasName             String @map("alias_name")
  aliasNameNorm         String @map("alias_name_norm")
  canonicalMenuName     String @map("canonical_menu_name")
  canonicalMenuNameNorm String @map("canonical_menu_name_norm")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([locationId, aliasNameNorm], map: "uq_menu_alias_branch_alias_norm")
  @@index([locationId, canonicalMenuNameNorm], map: "ix_menu_alias_branch_canonical_norm")
  @@map("menu_alias")
  @@schema("public")
}

model InstagramCampaign {
  id Int @id @default(autoincrement())

  locationId Int      @map("branch_id")
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  externalCampaignId String? @map("external_campaign_id")
  name               String
  platform           String  @default("instagram")
  objective          String?
  status             String  @default("draft")
  startsAt           DateTime? @map("starts_at")
  endsAt             DateTime? @map("ends_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  posts InstagramPost[]
  weeklyScheduleEntries InstagramWeeklyScheduleEntry[]

  @@index([locationId, startsAt], map: "ix_instagram_campaign_branch_starts_at")
  @@index([externalCampaignId], map: "ix_instagram_campaign_external_id")
  @@unique([locationId, platform, externalCampaignId], map: "uq_instagram_campaign_branch_platform_external")
  @@map("instagram_campaigns")
  @@schema("public")
}

model InstagramPost {
  id Int @id @default(autoincrement())

  locationId Int      @map("branch_id")
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  campaignId Int?                @map("campaign_id")
  campaign   InstagramCampaign?  @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  platform       String  @default("instagram")
  platformPostId String? @map("platform_post_id")
  status         String  @default("draft")
  mediaType      String? @map("media_type")
  caption        String?
  publishedAt    DateTime? @map("published_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  promotedItems InstagramPostPromotedItem[]
  weeklyScheduleEntries InstagramWeeklyScheduleEntry[]

  @@index([locationId, publishedAt], map: "ix_instagram_post_branch_published_at")
  @@index([platformPostId], map: "ix_instagram_post_platform_post_id")
  @@index([campaignId], map: "ix_instagram_post_campaign_id")
  @@unique([locationId, platform, platformPostId], map: "uq_instagram_post_branch_platform_external")
  @@map("instagram_posts")
  @@schema("public")
}

model InstagramPostPromotedItem {
  id Int @id @default(autoincrement())

  locationId Int      @map("branch_id")
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  instagramPostId Int           @map("instagram_post_id")
  instagramPost   InstagramPost @relation(fields: [instagramPostId], references: [id], onDelete: Cascade)

  canonicalMenuName     String @map("canonical_menu_name")
  canonicalMenuNameNorm String @map("canonical_menu_name_norm")
  source                String @default("manual")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([instagramPostId, canonicalMenuNameNorm], map: "uq_instagram_post_promoted_item_post_menu_norm")
  @@index([locationId, canonicalMenuNameNorm], map: "ix_instagram_post_promoted_item_branch_menu_norm")
  @@index([instagramPostId], map: "ix_instagram_post_promoted_item_post_id")
  @@map("instagram_post_promoted_items")
  @@schema("public")
}

model InstagramWeeklySchedule {
  id Int @id @default(autoincrement())

  locationId Int      @map("branch_id")
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  weekStartDate DateTime @db.Date @map("week_start_date")
  weekEndDate   DateTime @db.Date @map("week_end_date")
  status        String   @default("draft")
  source        String   @default("manual")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  entries InstagramWeeklyScheduleEntry[]
  postDrafts InstagramSchedulePostDraft[]

  @@unique([locationId, weekStartDate], map: "uq_instagram_weekly_schedule_branch_week_start")
  @@index([locationId, weekStartDate], map: "ix_instagram_weekly_schedule_branch_week_start")
  @@map("instagram_weekly_schedules")
  @@schema("public")
}

model InstagramWeeklyScheduleEntry {
  id Int @id @default(autoincrement())

  scheduleId Int                     @map("schedule_id")
  schedule   InstagramWeeklySchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  locationId Int      @map("branch_id")
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  instagramCampaignId Int?               @map("instagram_campaign_id")
  instagramCampaign   InstagramCampaign? @relation(fields: [instagramCampaignId], references: [id], onDelete: SetNull)

  instagramPostId Int?           @map("instagram_post_id")
  instagramPost   InstagramPost? @relation(fields: [instagramPostId], references: [id], onDelete: SetNull)

  canonicalMenuName     String   @map("canonical_menu_name")
  canonicalMenuNameNorm String   @map("canonical_menu_name_norm")
  scheduledFor          DateTime @map("scheduled_for")
  daypart               String?
  confidence            String   @default("medium")
  rationale             String?  @map("rationale")
  status                String   @default("draft")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  postDraft InstagramSchedulePostDraft?

  @@unique([scheduleId, canonicalMenuNameNorm, scheduledFor], map: "uq_instagram_weekly_schedule_entry_key")
  @@index([locationId, scheduledFor], map: "ix_instagram_weekly_schedule_entry_branch_scheduled_for")
  @@index([scheduleId, scheduledFor], map: "ix_instagram_weekly_schedule_entry_schedule_scheduled_for")
  @@index([instagramCampaignId], map: "ix_instagram_weekly_schedule_entry_campaign_id")
  @@index([instagramPostId], map: "ix_instagram_weekly_schedule_entry_post_id")
  @@map("instagram_weekly_schedule_entries")
  @@schema("public")
}

model InstagramSchedulePostDraft {
  id Int @id @default(autoincrement())

  locationId Int      @map("branch_id")
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  analyticsId Int?      @map("analytics_id")
  analytics   Analytics? @relation(fields: [analyticsId], references: [id], onDelete: SetNull)

  scheduleId Int                     @map("schedule_id")
  schedule   InstagramWeeklySchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  scheduleEntryId Int                          @unique(map: "uq_instagram_schedule_post_draft_schedule_entry_id") @map("schedule_entry_id")
  scheduleEntry   InstagramWeeklyScheduleEntry @relation(fields: [scheduleEntryId], references: [id], onDelete: Cascade)

  status               String @default("draft")
  campaignObjective    String? @map("campaign_objective")
  offerType            String? @map("offer_type")
  caption              String
  callToAction         String? @map("call_to_action")
  hashtagsJson         Json?   @map("hashtags_json")
  suggestedPublishAt   DateTime? @map("suggested_publish_at")
  generationInputJson  Json?   @map("generation_input_json")
  generationOutputJson Json?   @map("generation_output_json")
  sourceSignalsJson    Json?   @map("source_signals_json")
  version              Int     @default(1)
  approvedAt           DateTime? @map("approved_at")
  publishedAt          DateTime? @map("published_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  statusHistory InstagramSchedulePostDraftHistory[]

  @@index([locationId, status], map: "ix_instagram_schedule_post_draft_branch_status")
  @@index([scheduleId], map: "ix_instagram_schedule_post_draft_schedule_id")
  @@index([analyticsId], map: "ix_instagram_schedule_post_draft_analytics_id")
  @@map("instagram_schedule_post_drafts")
  @@schema("public")
}

model InstagramSchedulePostDraftHistory {
  id Int @id @default(autoincrement())

  draftId Int                       @map("draft_id")
  draft   InstagramSchedulePostDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  fromStatus String? @map("from_status")
  toStatus   String  @map("to_status")
  actor      String?
  reason     String?
  metadata   Json?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([draftId, createdAt], map: "ix_instagram_schedule_post_draft_history_draft_created_at")
  @@map("instagram_schedule_post_draft_history")
  @@schema("public")
}

//
// --------------------------------------------------
// Analytics (analysis context / immutable snapshot)
// --------------------------------------------------
//

model Analytics {
  id Int @id @default(autoincrement())

  // Context
  locationId Int      @map("branch_id")
  location   Location @relation(fields: [locationId], references: [id], onDelete: Restrict)

  // Timing
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  // Source metadata
  sourceFile String? @map("source_file")

  // Period boundaries
  periodStart DateTime? @db.Date @map("period_start")
  periodEnd   DateTime? @db.Date @map("period_end")

  // Global KPIs
  totalOrders     Int?
  totalItemsSold  Int?
  totalRevenue    Decimal? @db.Decimal(12, 2)
  totalCogs       Decimal? @db.Decimal(12, 2)  // Σ(cogs × quantity)
  totalProfit     Decimal? @db.Decimal(12, 2)  // totalRevenue − totalCogs
  totalMargin     Decimal? @db.Decimal(6, 4)   // (totalRevenue − totalCogs) ÷ totalRevenue
  avgOrderRevenue Decimal? @db.Decimal(12, 2)
  avgOrderItems   Decimal? @db.Decimal(10, 2)

  // Menu Engineering thresholds
  avgPopularity Decimal? @db.Decimal(10, 6)

  // Other KPIs
  maxOrderItems   Int?
  minOrderItems   Int?
  maxOrderRevenue Decimal? @db.Decimal(12, 2)
  minOrderRevenue Decimal? @db.Decimal(12, 2)

  // Derived analytics results (immutable snapshot)
  matrixJson             Json? @map("matrix_json")
  matrixDistributionJson Json? @map("matrix_distribution_json")
  heatmapJson            Json? @map("heatmap_json")
  popularityJson         Json? @map("popularity_json")
  insightsJson           Json? @map("insights_json")

  menuItems AnalyticsMenuItem[]
  agentOutputs AgentOutput[]
  etlJobs      EtlJob[]
  etlPipelineRuns EtlPipelineRun[]
  anomalyEvents AnomalyEvent[]
  instagramSchedulePostDrafts InstagramSchedulePostDraft[]

  @@index([locationId], map: "ix_analytics_branch_id")
  @@map("analytics")
  @@schema("public")
}

model EtlJob {
  id String @id @default(cuid())

  locationId Int      @map("branch_id")
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  analyticsId Int?      @map("analytics_id")
  analytics   Analytics? @relation(fields: [analyticsId], references: [id], onDelete: SetNull)

  sourceFile    String? @map("source_file")
  fileHash      String? @map("file_hash")
  idempotencyKey String? @unique(map: "uq_etl_jobs_idempotency_key") @map("idempotency_key")
  status        String  @default("queued")
  errorMessage  String? @map("error_message")
  pipelineRunId String? @db.Uuid @map("pipeline_run_id")

  startedAt  DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  pipelineLineageRuns EtlPipelineRun[]

  @@index([locationId, status], map: "ix_etl_jobs_branch_status")
  @@index([analyticsId], map: "ix_etl_jobs_analytics_id")
  @@map("etl_jobs")
  @@schema("public")
}

model EtlPipelineRun {
  id String @id @default(cuid())

  etlJobId String @map("etl_job_id")
  etlJob   EtlJob @relation(fields: [etlJobId], references: [id], onDelete: Cascade)

  locationId Int      @map("branch_id")
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  analyticsId Int?      @map("analytics_id")
  analytics   Analytics? @relation(fields: [analyticsId], references: [id], onDelete: SetNull)

  pipelineRunId String? @db.Uuid @map("pipeline_run_id")
  trigger       String
  source        String
  actor         String? @map("actor")
  status        String  @default("queued")
  retryCount    Int     @default(0) @map("retry_count")
  inputRef      Json?   @map("input_ref")
  outputRef     Json?   @map("output_ref")
  errorCode     String? @map("error_code")
  errorMessage  String? @map("error_message")

  startedAt DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stageExecutions EtlPipelineStageExecution[]

  @@unique([etlJobId], map: "uq_etl_pipeline_runs_etl_job_id")
  @@index([locationId, createdAt], map: "ix_etl_pipeline_runs_branch_created_at")
  @@index([status, createdAt], map: "ix_etl_pipeline_runs_status_created_at")
  @@index([pipelineRunId], map: "ix_etl_pipeline_runs_pipeline_run_id")
  @@map("etl_pipeline_runs")
  @@schema("public")
}

model EtlPipelineStageExecution {
  id String @id @default(cuid())

  runId String         @map("run_id")
  run   EtlPipelineRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  locationId Int      @map("branch_id")
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  stage      String
  status     String @default("queued")
  attempt    Int    @default(1)
  trigger    String
  source     String
  actor      String? @map("actor")
  inputRef   Json?   @map("input_ref")
  outputRef  Json?   @map("output_ref")
  errorCode  String? @map("error_code")
  errorMessage String? @map("error_message")

  startedAt DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([runId, stage, attempt], map: "uq_etl_pipeline_stage_run_stage_attempt")
  @@index([locationId, createdAt], map: "ix_etl_pipeline_stage_branch_created_at")
  @@index([status, createdAt], map: "ix_etl_pipeline_stage_status_created_at")
  @@index([runId, stage, status], map: "ix_etl_pipeline_stage_run_stage_status")
  @@map("etl_pipeline_stage_executions")
  @@schema("public")
}

//
// --------------------------------------------------
// Agent outputs (cached per analytics snapshot)
// --------------------------------------------------
//

model AgentOutput {
  id Int @id @default(autoincrement())

  agentId String @map("agent_id")

  locationId Int      @map("branch_id")
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  analyticsId Int @map("analytics_id")
  analytics   Analytics @relation(fields: [analyticsId], references: [id], onDelete: Cascade)

  outputs Json

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([agentId, locationId, analyticsId], map: "uq_agent_output_key")
  @@index([locationId, analyticsId, agentId], map: "ix_agent_output_lookup")
  @@map("agent_outputs")
  @@schema("public")
}

//
// --------------------------------------------------
// Fixed costs (location-scoped, mutable input data)
// --------------------------------------------------
//

model FixedCost {
  id Int @id @default(autoincrement())

  // Scope
  locationId Int      @map("branch_id")
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  // Identity
  name String

  // Economics
  amount Decimal @db.Decimal(12, 2)   // monthly (or chosen period)

  // Optional metadata
  category String?                   // e.g. "rent", "salaries", "utilities"
  notes    String?

  // Lifecycle
  isActive Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@index([locationId], map: "ix_fixed_costs_branch_id")
  @@map("fixed_costs")
  @@schema("public")
}

//
// --------------------------------------------------
// Menu items (aggregated facts per analytics period)
// --------------------------------------------------
//

model AnalyticsMenuItem {
  id Int @id @default(autoincrement())

  // Scope
  analyticsId Int @map("analytics_id")
  analytics   Analytics @relation(fields: [analyticsId], references: [id], onDelete: Cascade)

  // Identity within analytics context
  menuName String @map("menu_name")

  // Menu categorization
  menuCategory       String? @map("menu_category")
  menuCategoryDetail String? @map("menu_category_detail")

  // Immutable sales facts
  quantity     Int
  totalRevenue Decimal @db.Decimal(12, 2)

  // Optional enrichment
  cogs Decimal? @db.Decimal(10, 2)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([analyticsId, menuName], map: "uq_menu_item_per_analytics")
  @@index([analyticsId], map: "ix_menu_items_analytics_id")
  @@index([menuCategory], map: "ix_menu_items_menu_category")

  @@map("analytics_menu_items")
  @@schema("public")
}

//
// --------------------------------------------------
// Staging layer (ETL raw/clean/rejected)
// --------------------------------------------------
//

model StgPosRaw {
  id            BigInt   @id @default(autoincrement())
  pipelineRunId String   @db.Uuid @map("pipeline_run_id")
  sourceSystem  String   @map("source_system")
  sourceFile    String?  @map("source_file")
  rowHash       String   @map("row_hash")
  rowData       Json     @map("row_data")
  ingestedAtUtc DateTime @db.Timestamptz(6) @map("ingested_at_utc")
  createdAt     DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  @@unique([pipelineRunId, rowHash])
  @@index([pipelineRunId], map: "ix_stg_pos_raw_pipeline_run_id")
  @@map("stg_pos_raw")
  @@schema("staging")
}

model StgPosRejected {
  id              BigInt   @id @default(autoincrement())
  pipelineRunId   String   @db.Uuid @map("pipeline_run_id")
  sourceSystem    String   @map("source_system")
  sourceFile      String?  @map("source_file")
  rowHash         String   @map("row_hash")
  rowData         Json     @map("row_data")
  rejectionReason String   @map("rejection_reason")
  ingestedAtUtc   DateTime @db.Timestamptz(6) @map("ingested_at_utc")
  createdAt       DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  @@unique([pipelineRunId, rowHash])
  @@index([pipelineRunId], map: "ix_stg_pos_rejected_pipeline_run_id")
  @@map("stg_pos_rejected")
  @@schema("staging")
}

model StgPosClean {
  id                     BigInt   @id @default(autoincrement())
  pipelineRunId          String   @db.Uuid @map("pipeline_run_id")
  sourceSystem           String   @map("source_system")
  sourceFile             String?  @map("source_file")
  rowHash                String   @map("row_hash")
  billNumber             String   @map("bill_number")
  menu                   String
  qty                    Decimal  @db.Decimal(12, 3)
  price                  Decimal  @db.Decimal(14, 4)
  totalAfterBillDiscount Decimal  @db.Decimal(14, 4) @map("total_after_bill_discount")
  orderTime              DateTime @db.Timestamptz(6) @map("order_time")
  menuCategory           String   @map("menu_category")
  menuCategoryDetail     String   @map("menu_category_detail")
  ingestedAtUtc          DateTime @db.Timestamptz(6) @map("ingested_at_utc")
  createdAt              DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  @@unique([pipelineRunId, rowHash])
  @@index([pipelineRunId], map: "ix_stg_pos_clean_pipeline_run_id")
  @@index([orderTime], map: "ix_stg_pos_clean_order_time")
  @@map("stg_pos_clean")
  @@schema("staging")
}

//
// --------------------------------------------------
// Warehouse layer (dimensions/facts/quality)
// --------------------------------------------------
//

model DimPipelineRun {
  pipelineRunId String   @id @db.Uuid @map("pipeline_run_id")
  schemaVersion String   @map("schema_version")
  sourceSystem  String   @map("source_system")
  sourceFile    String?  @map("source_file")
  ingestedAtUtc DateTime @db.Timestamptz(6) @map("ingested_at_utc")
  qualityStatus String   @map("quality_status")
  createdAt     DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  @@index([ingestedAtUtc], map: "ix_dim_pipeline_run_ingested_at")
  @@index([sourceSystem], map: "ix_dim_pipeline_run_source_system")
  @@map("dim_pipeline_run")
  @@schema("warehouse")
}

model DimDate {
  dateKey      Int      @id @map("date_key")
  fullDate     DateTime @db.Date @map("full_date")
  dayOfMonth   Int      @map("day_of_month")
  monthOfYear  Int      @map("month_of_year")
  yearNumber   Int      @map("year_number")
  weekdayIso   Int      @map("weekday_iso")
  isWeekend    Boolean  @map("is_weekend")

  @@unique([fullDate])
  @@map("dim_date")
  @@schema("warehouse")
}

model DimLocation {
  locationKey            BigInt   @id @default(autoincrement()) @map("location_key")
  operationalLocationId  Int      @unique @map("operational_location_id")
  locationName           String   @map("location_name")
  currencyCode           String   @map("currency_code")
  isActive               Boolean  @default(true) @map("is_active")
  createdAt              DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt              DateTime @default(now()) @db.Timestamptz(6) @map("updated_at")

  @@map("dim_location")
  @@schema("warehouse")
}

model DimPosSource {
  posSourceKey BigInt   @id @default(autoincrement()) @map("pos_source_key")
  sourceSystem String   @unique @map("source_system")
  createdAt    DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  @@map("dim_pos_source")
  @@schema("warehouse")
}

model DimMenuItem {
  menuItemKey         BigInt   @id @default(autoincrement()) @map("menu_item_key")
  locationKey         BigInt   @map("location_key")
  menuName            String   @map("menu_name")
  menuNameNorm        String   @map("menu_name_norm")
