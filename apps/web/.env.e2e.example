# Copy this file to .env.e2e for local E2E full-runner usage.
# This profile intentionally reuses the current DB in transition mode.

DATABASE_URL="postgresql://<user>:<password>@<host>/<db>?sslmode=require"
ANALYTICS_API_URL="http://127.0.0.1:8000"
AGENTS_API_URL="http://127.0.0.1:8001"
E2E_BASE_URL="http://127.0.0.1:3000"

# Safety guardrails
E2E_DB_FORBIDDEN_PATTERN="(prod|production)"
# Optional: require DB URL to match this pattern.
# E2E_DB_REQUIRED_PATTERN="menuyukti|dev|staging"

# Optional: comma-separated suite override (default is full suite).
# E2E_SUITE_LIST="test:e2e:matrix,test:e2e:pairs"
