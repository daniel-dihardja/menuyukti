{
  "schemaVersion": "v1",
  "id": "pairs-route-exploration",
  "title": "Pairs Route Exploration",
  "baseUrl": "http://127.0.0.1:3000",
  "persona": "analyst",
  "focusAreas": ["data_visibility", "layout_overflow", "runtime_errors"],
  "guardrails": {
    "maxSteps": 40,
    "stepTimeoutMs": 10000,
    "maxDurationMs": 180000,
    "allowDestructiveActions": false,
    "allowedDomains": ["127.0.0.1", "localhost"]
  },
  "scenarios": [
    {
      "id": "pairs-main",
      "name": "Open pairs page and inspect KPI/tooling visibility",
      "route": "/analytics/1/pairs",
      "objective": "Verify KPI cards, filter controls, and top table sections render.",
      "actions": [
        { "type": "goto", "url": "http://127.0.0.1:3000/analytics/1/pairs" },
        { "type": "waitFor", "selector": "h1" },
        { "type": "screenshot", "name": "pairs-overview", "fullPage": true }
      ]
    }
  ]
}
