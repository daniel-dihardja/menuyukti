{
  "schemaVersion": "v1",
  "id": "sales-route-exploration",
  "title": "Sales Route Exploration",
  "baseUrl": "http://127.0.0.1:3000",
  "persona": "mixed",
  "focusAreas": ["navigation", "ux_clarity", "runtime_errors"],
  "guardrails": {
    "maxSteps": 30,
    "stepTimeoutMs": 10000,
    "maxDurationMs": 180000,
    "allowDestructiveActions": false,
    "allowedDomains": ["127.0.0.1", "localhost"]
  },
  "scenarios": [
    {
      "id": "sales-overview",
      "name": "Open sales page and verify upload/list shell",
      "route": "/analytics/sales",
      "objective": "Ensure main sales route renders and action entry points are visible.",
      "actions": [
        { "type": "goto", "url": "http://127.0.0.1:3000/analytics/sales" },
        { "type": "waitFor", "selector": "h1" },
        { "type": "screenshot", "name": "sales-overview", "fullPage": true }
      ]
    }
  ]
}
