# GraphQL service-only overrides (optional).
#
# Shared secrets live in the **repo-root** `.env` (see `/.env.example`):
# DATABASE_URL, INTERNAL_API_KEY / GRAPHQL_INTERNAL_API_KEY, AI_GATEWAY_API_KEY, etc.
#
# Python loads root `.env` first, then this file with override=True.
# You do not need to duplicate DATABASE_URL or gateway keys here.

# CRM customer device JWTs (HS256). Required for CRM enroll/auth; ≥32 characters.
# CRM_JWT_SECRET=

# Allow staff Mock data seed (`ingestDevData`) in production-like envs.
# ALLOW_DEV_DATA_INGEST=1

# Force production-style startup checks (require internal API key).
# GRAPHQL_REQUIRE_INTERNAL_API_KEY=1
# GRAPHQL_ENV=production

# Knowledge embedding overrides (defaults use AI_GATEWAY_API_KEY from root).
# KNOWLEDGE_EMBEDDING_MODEL=text-embedding-3-small
# KNOWLEDGE_EMBEDDING_BASE_URL=https://ai-gateway.vercel.sh/v1
# OPENAI_API_KEY=
